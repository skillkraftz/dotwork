{
  "format": "dotwork-spread",
  "version": 2,
  "name": "Dot grid spread",
  "left": {
    "format": "dotwork-page",
    "version": 2,
    "name": "Dot grid page",
    "identity": "{monthname} {year}",
    "side": "left",
    "grid": {"cols": 27, "rows": 44, "pitch_mm": 3},
    "elements": [
      {"type": "pattern", "pattern": "dots", "x": 0, "y": 1, "w": 27, "h": 43}
    ]
  },
  "right": {
    "format": "dotwork-page",
    "version": 2,
    "name": "Dot grid page",
    "identity": "{monthname} {year}",
    "side": "right",
    "grid": {"cols": 27, "rows": 44, "pitch_mm": 3},
    "elements": [
      {"type": "pattern", "pattern": "dots", "x": 0, "y": 1, "w": 27, "h": 43}
    ]
  }
}
